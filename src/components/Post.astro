---
import { render, type CollectionEntry } from "astro:content";
import Base from "../layouts/Base.astro";

interface Props {
    post?: CollectionEntry<"posts">;
    frontmatter?: {
        title?: string;
        description?: string;
        updated?: string;
    };
}

const { post, frontmatter } = Astro.props;
const title = post?.data.title ?? frontmatter?.title ?? post?.id;
const description = post?.data.description ?? frontmatter?.description;
const updated = post?.data.updated ?? frontmatter?.updated;
const { Content } = post ? await render(post) : { Content: undefined };
---

<Base>
    <article>
        {title && <h1>{title}</h1>}
        {description && <p>{description}</p>}
        {updated && <time datetime={updated}>{updated}</time>}
        {post && Content ? <Content /> : <slot />}
    </article>
</Base>

<style>
    article {
        width: min(calc(100% - 48px), 900px);
        margin: 24px auto;
        padding: clamp(24px, 5vw, 60px);
        border: 1px solid var(--border);
        background: var(--surface);
        box-shadow: 0 18px 55px rgb(32 54 83 / 7%);
        color: var(--text-primary);
        overflow-wrap: anywhere;
    }

    article > h1:first-child {
        margin: 0 0 12px;
        font-size: clamp(2rem, 5vw, 2.8rem);
        letter-spacing: -0.045em;
        line-height: 1.2;
    }

    article > h1:first-child + p {
        margin: 0 0 14px;
        color: var(--text-secondary);
        font-size: 1.08rem;
        line-height: 1.7;
    }

    article > time {
        display: block;
        margin-bottom: 2.5rem;
        color: var(--text-secondary);
        font-size: 0.84rem;
        font-variant-numeric: tabular-nums;
    }

    article :global(h1),
    article :global(h2),
    article :global(h3),
    article :global(h4),
    article :global(h5),
    article :global(h6) {
        margin: 2em 0 0.7em;
        color: var(--text-primary);
        font-weight: 700;
        line-height: 1.35;
        letter-spacing: -0.025em;
    }

    article :global(h1) {
        font-size: 1.9rem;
    }

    article :global(h2) {
        font-size: 1.55rem;
    }

    article :global(h2)::before {
        content: "§";
        display: inline-block;
        margin-right: 0.55em;
        color: var(--accent);
        font-weight: 400;
    }

    article :global(h3) {
        font-size: 1.28rem;
    }

    article :global(h4) {
        font-size: 1.12rem;
    }

    article :global(h5),
    article :global(h6) {
        font-size: 1rem;
    }

    article :global(p) {
        margin: 0 0 1.15em;
        line-height: 1.85;
    }

    article :global(a) {
        color: var(--accent);
        text-decoration-color: rgb(61 111 168 / 40%);
        text-underline-offset: 0.2em;
        transition: color 0.15s ease, text-decoration-color 0.15s ease;
    }

    article :global(a:hover) {
        color: #2d5687;
        text-decoration-color: currentColor;
    }

    article :global(strong) {
        color: #2c3b50;
        font-weight: 700;
    }

    article :global(em) {
        font-style: italic;
    }

    article :global(ul),
    article :global(ol) {
        margin: 0 0 1.35em;
        padding-left: 1.6em;
    }

    article :global(ul) {
        list-style-type: disc;
    }

    article :global(ol) {
        list-style-type: decimal;
    }

    article :global(li) {
        margin: 0.35em 0;
        padding-left: 0.15em;
    }

    article :global(li > ul),
    article :global(li > ol) {
        margin-top: 0.35em;
        margin-bottom: 0.35em;
    }

    article :global(input[type="checkbox"]) {
        margin: 0 0.45em 0 0;
        accent-color: var(--accent);
        vertical-align: -1px;
    }

    article :global(blockquote) {
        margin: 1.5em 0;
        padding: 1em 1.25em;
        border-left: 4px solid var(--accent);
        background: #edf3fa;
        color: #566b86;
    }

    article :global(blockquote > :last-child) {
        margin-bottom: 0;
    }

    article :global(code) {
        padding: 0.15em 0.4em;
        border: 1px solid #d9e3f1;
        background: #eff4fb;
        color: #315b91;
        font-size: 0.88em;
    }

    article :global(pre) {
        max-width: 100%;
        margin: 1.5em 0;
        padding: 1.2em 1.35em;
        overflow-x: auto;
        border: 0;
        border-left: 4px solid var(--accent);
        background: #edf3fa;
        color: #566b86;
        font-size: 0.9rem;
        line-height: 1.7;
        tab-size: 4;
    }

    article :global(pre.astro-code) {
        background-color: #edf3fa !important;
        color: #566b86 !important;
    }

    article :global(pre code) {
        padding: 0;
        border: 0;
        background: transparent;
        color: inherit;
        font-size: inherit;
    }

    article :global(table) {
        display: block;
        width: 100%;
        margin: 1.5em 0;
        overflow-x: auto;
        border-collapse: collapse;
        font-size: 0.94rem;
    }

    article :global(th),
    article :global(td) {
        padding: 0.75em 0.9em;
        border: 1px solid var(--border);
        text-align: left;
    }

    article :global(th) {
        background: #f2f6fb;
        font-weight: 700;
        white-space: nowrap;
    }

    article :global(hr) {
        height: 1px;
        margin: 2.5em 0;
        border: 0;
        background: var(--border);
    }

    article :global(img) {
        display: block;
        max-width: 100%;
        height: auto;
        margin: 1.5em auto;
    }

    article :global(kbd) {
        padding: 0.2em 0.5em;
        border: 1px solid #d5deeb;
        border-bottom-width: 2px;
        background: #f7f9fc;
        color: var(--text-primary);
        font-size: 0.82em;
    }

    article :global(mark) {
        padding: 0.05em 0.2em;
        background: #fff0b8;
    }

    article :global(details) {
        margin: 1.5em 0;
        padding: 1em 1.2em;
        border: 1px solid var(--border);
        background: #f7f9fc;
    }

    article :global(summary) {
        color: var(--text-primary);
        cursor: pointer;
        font-weight: 700;
    }

    article :global(details[open] summary) {
        margin-bottom: 0.8em;
    }

    article :global(dl) {
        margin: 1.5em 0;
    }

    article :global(dt) {
        margin-top: 0.8em;
        font-weight: 700;
    }

    article :global(dd) {
        margin-left: 1.5em;
        color: var(--text-secondary);
    }

    article :global([data-footnotes]) {
        margin-top: 2.5em;
        padding-top: 1em;
        border-top: 1px solid var(--border);
        color: var(--text-secondary);
        font-size: 0.9rem;
    }

    article :global([data-footnotes] ol) {
        margin-bottom: 0;
    }

    @media (max-width: 1023px) {
        article {
            width: calc(100% - 32px);
            margin: 76px auto 24px;
            padding: 30px 24px;
        }
    }

    @media (max-width: 560px) {
        article {
            padding: 25px 19px;
        }

        article > time {
            margin-bottom: 2rem;
        }

        article :global(h1) {
            font-size: 1.65rem;
        }

        article :global(h2) {
            font-size: 1.38rem;
        }

        article :global(pre) {
            padding: 1em;
            font-size: 0.82rem;
        }
    }
</style>
