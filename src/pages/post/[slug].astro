---
import { getCollection } from "astro:content";
import Post from "../../components/Post.astro";

export async function getStaticPaths() {
    const posts = await getCollection("posts");

    return posts.map((post) => ({
        params: { slug: post.id },
        props: { post },
    }));
}

const { post } = Astro.props;
---

<Post post={post} />
