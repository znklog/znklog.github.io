---
import "reset-css";
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="ZNKLOG.kr 개인 홈페이지 겸 블로그" />
    <title>ZNKLOG.kr</title>
  </head>
  <body>
    <div id="sidebar">
        <header>
            <h1>ZNKLOG.kr</h1>
        </header>
        <nav>
            <ul>
                <li><a href="/">Home</a></li>
                <li><a href="/posts">Posts</a></li>
            </ul>
        </nav>
        <footer>
            <p>&copy; 2026 ZNKLOG.kr. All rights reserved.</p>
        </footer>
    </div>
    <div id="mainview">
        <main>
            <slot />
        </main>
    </div>
    <div id="sidebar-toggle">
        <button onclick="document.getElementById('sidebar').classList.toggle('open');">☰</button>
    </div>
  </body>
</html>

<style>
    @font-face {
        font-family: "NanumSquareRound";
        src: url("/fonts/NanumSquareRound-Regular.woff2") format("woff2");
        font-weight: 400;
        font-style: normal;
        font-display: block;
    }

    @font-face {
        font-family: "D2Coding";
        src: url("/fonts/D2Coding-Regular.woff2") format("woff2");
        font-weight: 400;
        font-style: normal;
        font-display: block;
    }

    :global(:root) {
        color-scheme: light;
        --page-background: #f3f5f8;
        --surface: #ffffff;
        --text-primary: #202936;
        --text-secondary: #687586;
        --accent: #c45b42;
        --border: #e4e8ee;
    }

    :global(*) {
        box-sizing: border-box;
    }

    :global(html),
    :global(body) {
        position: fixed;
        inset: 0;
        overflow: hidden;
        margin: 0;
        background: var(--page-background);
        color: var(--text-primary);
    }

    :global(body) {
        font-family: "NanumSquareRound", sans-serif;
        font-size: 16px;
        line-height: 1.65;
        -webkit-font-smoothing: antialiased;
    }

    :global(pre),
    :global(code),
    :global(kbd),
    :global(samp) {
        font-family: "D2Coding", monospace;
    }

    #sidebar {
        position: fixed;
        top: 0;
        left: 0;
        bottom: 0;
        width: 288px;
        z-index: 100;
        display: flex;
        flex-direction: column;
        background: #3b2927;
        color: #f5f1ef;
        box-shadow: 8px 0 32px rgb(50 28 25 / 12%);
        transition: transform 0.25s ease;
    }

    #mainview {
        position: fixed;
        top: 0;
        left: 288px;
        right: 0;
        bottom: 0;
        z-index: 10;
        overflow-y: auto;
        background: var(--page-background);
        scrollbar-width: none;
        -ms-overflow-style: none;
    }

    #mainview::-webkit-scrollbar {
        display: none;
    }

    #sidebar-toggle {
        position: fixed;
        top: 16px;
        right: 16px;
        height: 44px;
        width: 44px;
        z-index: 200;
        display: none;
    }

    header,
    nav,
    footer {
        padding: 24px;
    }

    header {
        flex: 0 0 auto;
        display: flex;
        align-items: center;
        min-height: 104px;
        border-bottom: 1px solid rgb(255 255 255 / 10%);
    }

    header h1 {
        margin: 0;
        color: #fff;
        font-size: 1.3rem;
        letter-spacing: 0.02em;
    }

    nav {
        flex: 1 1 auto;
        padding-top: 20px;
    }

    nav ul {
        margin: 0;
        padding: 0;
        list-style: none;
    }

    nav li + li {
        margin-top: 8px;
    }

    nav a {
        display: block;
        padding: 11px 14px;
        color: #e0d2cf;
        font-size: 0.98rem;
        text-decoration: none;
        transition: background-color 0.2s ease, color 0.2s ease;
    }

    nav a:hover,
    nav a:focus-visible {
        background: rgb(255 255 255 / 10%);
        color: #fff;
        outline: none;
    }

    footer {
        flex: 0 0 auto;
        border-top: 1px solid rgb(255 255 255 / 10%);
        color: #b7a4a0;
        font-size: 0.78rem;
    }

    footer p {
        margin: 0;
    }

    #mainview > main {
        width: 100%;
        height: 100%;
        padding: 0;
    }

    #sidebar-toggle button {
        display: grid;
        width: 44px;
        height: 44px;
        place-items: center;
        border: 1px solid var(--border);
        background: var(--surface);
        color: var(--text-primary);
        box-shadow: 0 4px 16px rgb(51 30 27 / 12%);
        cursor: pointer;
        font: inherit;
        font-size: 1.25rem;
    }

    #sidebar-toggle button:focus-visible {
        outline: 3px solid rgb(196 91 66 / 35%);
        outline-offset: 3px;
    }

    @media (max-width: 1023px) {
        #sidebar {
            width: min(288px, 86vw);
            transform: translateX(-100%);
        }

        #sidebar.open {
            transform: translateX(0);
        }

        #mainview {
            left: 0;
        }

        #sidebar-toggle {
            display: block;
        }

    }

    @media (prefers-reduced-motion: reduce) {
        #sidebar,
        nav a {
            transition: none;
        }
    }
</style>